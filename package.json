{
  "name": "@fgarend/moneta",
  "version": "0.7.0",
  "private": true,
  "description": "A component library for money interfaces, built on shadcn.",
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/fgarend/moneta.git"
  },
  "type": "module",
  "exports": {
    "./styles.css": "./dist/styles/styles.css",
    "./theme.css": "./dist/styles/theme.css",
    "./fonts.css": "./dist/styles/fonts.css",
    "./*": "./dist/components/*.js"
  },
  "imports": {
    "#components/*": {
      "moneta-source": "./src/components/*.tsx",
      "default": "./dist/components/*.js"
    },
    "#hooks/*": {
      "moneta-source": "./src/hooks/*.ts",
      "default": "./dist/hooks/*.js"
    },
    "#lib/*": {
      "moneta-source": "./src/lib/*.ts",
      "default": "./dist/lib/*.js"
    }
  },
  "files": [
    "dist",
    "docs/guidelines.md"
  ],
  "sideEffects": [
    "**/*.css"
  ],
  "packageManager": "pnpm@12.17.0",
  "devDependencies": {
    "@biomejs/biome": "2.6.4",
    "@storybook/addon-a11y": "10.6.5",
    "@storybook/addon-themes": "10.6.5",
    "@storybook/addon-vitest": "10.6.5",
    "@storybook/react-vite": "10.6.5",
    "@tailwindcss/cli": "4.3.4",
    "@tailwindcss/vite": "4.3.4",
    "@types/node": "26.6.6",
    "@types/react": "19.3.0",
    "@types/react-dom": "19.3.0",
    "@vitest/browser-playwright": "5.1.0",
    "@vitest/coverage-istanbul": "5.1.0",
    "lucide-react": "1.67.0",
    "playwright": "1.64.1",
    "react": "19.3.1",
    "react-aria-components": "1.22.1",
    "react-dom": "19.3.1",
    "storybook": "10.6.5",
    "tailwindcss": "4.3.4",
    "typescript": "7.0.2",
    "vite": "8.3.5",
    "vitest": "5.1.0",
    "vitest-browser-react": "2.3.0"
  },
  "peerDependencies": {
    "lucide-react": "^1.65.0",
    "react": "^19.0.0",
    "react-aria-components": "^1.22.1",
    "react-dom": "^19.0.0",
    "tailwindcss": "^4.3.3"
  },
  "dependencies": {
    "@fontsource-variable/geist": "5.3.0",
    "class-variance-authority": "0.7.1",
    "cn": "0.5.2",
    "tw-animate-css": "1.4.0"
  },
  "peerDependenciesMeta": {
    "tailwindcss": {
      "optional": true
    }
  }
}
