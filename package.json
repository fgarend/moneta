{
  "name": "@fgarend/moneta",
  "version": "0.4.0",
  "private": true,
  "description": "A component library for money interfaces, built on shadcn.",
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/fgarend/moneta.git"
  },
  "type": "module",
  "exports": {
    "./table": "./dist/components/table.js",
    "./empty": "./dist/components/empty.js",
    "./breadcrumb": "./dist/components/breadcrumb.js",
    "./avatar": "./dist/components/avatar.js",
    "./alert-dialog": "./dist/components/alert-dialog.js",
    "./pagination": "./dist/components/pagination.js",
    "./toggle-group": "./dist/components/toggle-group.js",
    "./spinner": "./dist/components/spinner.js",
    "./skeleton": "./dist/components/skeleton.js",
    "./popover": "./dist/components/popover.js",
    "./kbd": "./dist/components/kbd.js",
    "./hover-card": "./dist/components/hover-card.js",
    "./collapsible": "./dist/components/collapsible.js",
    "./card": "./dist/components/card.js",
    "./aspect-ratio": "./dist/components/aspect-ratio.js",
    "./alert": "./dist/components/alert.js",
    "./label": "./dist/components/label.js",
    "./textarea": "./dist/components/textarea.js",
    "./input": "./dist/components/input.js",
    "./separator": "./dist/components/separator.js",
    "./button": "./dist/components/button.js",
    "./section": "./dist/components/section.js",
    "./styles.css": "./dist/styles/styles.css",
    "./theme.css": "./dist/styles/theme.css",
    "./fonts.css": "./dist/styles/fonts.css",
    "./*": "./dist/components/ui/*.js"
  },
  "imports": {
    "#components/*": {
      "moneta-source": "./src/components/*.tsx",
      "default": "./dist/components/*.js"
    },
    "#hooks/*": {
      "moneta-source": "./src/hooks/*.ts",
      "default": "./dist/hooks/*.js"
    },
    "#lib/*": {
      "moneta-source": "./src/lib/*.ts",
      "default": "./dist/lib/*.js"
    }
  },
  "files": [
    "dist",
    "docs/guidelines.md"
  ],
  "sideEffects": [
    "**/*.css"
  ],
  "packageManager": "pnpm@12.17.0",
  "devDependencies": {
    "@biomejs/biome": "2.6.4",
    "@storybook/addon-a11y": "10.6.5",
    "@storybook/addon-themes": "10.6.5",
    "@storybook/addon-vitest": "10.6.5",
    "@storybook/react-vite": "10.6.5",
    "@tailwindcss/cli": "4.3.3",
    "@tailwindcss/vite": "4.3.3",
    "@types/node": "26.6.6",
    "@types/react": "19.3.0",
    "@types/react-dom": "19.3.0",
    "@vitest/browser-playwright": "5.1.0",
    "@vitest/coverage-istanbul": "5.1.0",
    "lucide-react": "1.66.0",
    "playwright": "1.64.1",
    "react": "19.3.1",
    "react-aria-components": "1.22.1",
    "react-dom": "19.3.1",
    "storybook": "10.6.5",
    "tailwindcss": "4.3.3",
    "typescript": "7.0.2",
    "vite": "8.3.5",
    "vitest": "5.1.0",
    "vitest-browser-react": "2.3.0"
  },
  "peerDependencies": {
    "lucide-react": "^1.65.0",
    "react": "^19.0.0",
    "react-aria-components": "^1.22.1",
    "react-dom": "^19.0.0",
    "tailwindcss": "^4.3.3"
  },
  "dependencies": {
    "@fontsource-variable/geist": "5.3.0",
    "class-variance-authority": "0.7.1",
    "cn": "0.5.2",
    "tw-animate-css": "1.4.0"
  },
  "peerDependenciesMeta": {
    "tailwindcss": {
      "optional": true
    }
  }
}
