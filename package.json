{
  "name": "@fgarend/moneta",
  "version": "0.0.0",
  "private": true,
  "description": "A component library for money interfaces, built on shadcn.",
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/fgarend/moneta.git"
  },
  "type": "module",
  "exports": {
    "./ui/*": "./dist/components/ui/*.js"
  },
  "imports": {
    "#components/*": {
      "moneta-source": "./src/components/*.tsx",
      "default": "./dist/components/*.js"
    },
    "#hooks/*": {
      "moneta-source": "./src/hooks/*.ts",
      "default": "./dist/hooks/*.js"
    },
    "#lib/*": {
      "moneta-source": "./src/lib/*.ts",
      "default": "./dist/lib/*.js"
    }
  },
  "files": [
    "dist"
  ],
  "sideEffects": false,
  "packageManager": "pnpm@12.17.0",
  "devDependencies": {
    "@biomejs/biome": "2.6.4",
    "@storybook/addon-a11y": "10.6.5",
    "@storybook/addon-vitest": "10.6.5",
    "@storybook/react-vite": "10.6.5",
    "@types/node": "26.6.6",
    "@types/react": "19.3.0",
    "@types/react-dom": "19.3.0",
    "@vitest/browser-playwright": "5.0.5",
    "@vitest/coverage-istanbul": "5.0.5",
    "lucide-react": "1.65.0",
    "playwright": "1.64.1",
    "react": "19.3.1",
    "react-aria-components": "1.22.1",
    "react-dom": "19.3.1",
    "storybook": "10.6.5",
    "typescript": "7.0.2",
    "vite": "8.3.5",
    "vitest": "5.0.5",
    "vitest-browser-react": "2.3.0"
  },
  "peerDependencies": {
    "lucide-react": "^1.65.0",
    "react": "^19.0.0",
    "react-aria-components": "^1.22.1",
    "react-dom": "^19.0.0"
  },
  "dependencies": {
    "class-variance-authority": "0.7.1",
    "cn": "0.5.1"
  }
}
