# Each tool adds its own section in the commit that introduces it.

# macOS
.DS_Store

# Editors
.idea/
.vscode/
*.swp

# Dependencies, installed by make install
node_modules/

# Environment files with secrets: never versioned.
.env
.env.*

# The images a failing visual test writes, to look at
.vitest/

# The reports make test and make stories write
coverage/

# What make package writes: the build, and the tarball it tested, which is what gets delivered
dist/
.package/

# What make storybook-build writes: the gallery a release publishes
storybook-static/
