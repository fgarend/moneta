// TypeScript settings for the build: what enters the package, and where it is written.
{
  "extends": "./tsconfig.json",
  "exclude": ["src/**/*.stories.tsx", "src/**/*.test.ts"],
  "compilerOptions": {
    "noEmit": false,
    // What is built resolves as an app will: to dist.
    "customConditions": [],
    "rootDir": "src",
    "outDir": "dist",
    "declaration": true
  }
}
