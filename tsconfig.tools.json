// TypeScript settings for what runs around the library: the tests, the stories and the settings of both.
{
  "extends": "./tsconfig.json",
  "include": [
    "test",
    "scripts",
    "vitest.config.ts",
    ".storybook",
    "src/**/*.stories.tsx"
  ],
  "exclude": [],
  "compilerOptions": {
    // Node's APIs, and Vite's client types, which declare import.meta.glob.
    "types": ["node", "vite/client"],
    // Storybook's own declaration files do not pass TypeScript 7 yet. Our use of them is still checked.
    "skipLibCheck": true
  }
}
