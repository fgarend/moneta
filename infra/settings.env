# Settings of the containers, read by Compose. Versioned: it never holds a secret.
# A value given on the command line wins for that run only, such as PLAYWRIGHT_IMAGE=… make check.

# The images the environment starts from. docs/updating.md says how they move.
PLAYWRIGHT_IMAGE=mcr.microsoft.com/playwright:v1.64.1-noble@sha256:2f05f8a734509a7b3f26a912639488ee08f58a7b292d14d62271bcff9038768f
PNPM_IMAGE=ghcr.io/pnpm/pnpm:12.18.0@sha256:41c39d1c734b0a810669c07587888aa7dbe9ef9b4c8e98b346b3654f7b269b6d
# The port make storybook serves the gallery on, at http://localhost:<port>.
STORYBOOK_PORT=6006
